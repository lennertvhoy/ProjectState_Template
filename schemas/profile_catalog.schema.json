{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projectstate.profile_catalog.v1",
  "title": "ProjectState profile and asset-set catalog",
  "type": "object",
  "required": [
    "schema",
    "catalog_version",
    "template_version",
    "asset_sets",
    "profiles",
    "lifecycle_defaults"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "enum": [
        "projectstate.profile_catalog.v1",
        "statedd.profile_catalog.v1"
      ]
    },
    "catalog_version": {
      "type": "integer",
      "minimum": 1
    },
    "template_version": {
      "type": "string",
      "minLength": 1
    },
    "asset_sets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "version",
          "depends_on",
          "conflicts_with",
          "capabilities",
          "validation",
          "assets"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "conflicts_with": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "optional": {
            "type": "boolean"
          },
          "assets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "depends_on",
          "asset_sets",
          "required_capabilities",
          "required_gate_level"
        ],
        "additionalProperties": false,
        "properties": {
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "asset_sets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_gate_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "lifecycle_defaults": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "role",
          "owner",
          "required",
          "provision",
          "merge_strategy",
          "sensitivity",
          "protected",
          "append_only"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "enum": [
              "template",
              "project"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "provision": {
            "type": "string",
            "minLength": 1
          },
          "merge_strategy": {
            "type": "string",
            "enum": [
              "preserve",
              "append-only",
              "create-if-missing",
              "replace-if-unmodified",
              "regenerate",
              "forbid"
            ]
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "public",
              "project",
              "sensitive"
            ]
          },
          "protected": {
            "type": "boolean"
          },
          "append_only": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
